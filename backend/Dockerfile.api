# Image for the api, plus the one-shot init (secret generation) and migrate
# services. No ODBC driver: the api never talks to site databases.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Trust any extra root certificates placed in ./certs (TLS-inspecting networks;
# see certs/README.md). Does nothing when the folder holds only its README.
COPY --from=certs . /tmp/extra-certs/
RUN set -e; n=0; \
    for f in /tmp/extra-certs/*.crt /tmp/extra-certs/*.pem; do \
      [ -f "$f" ] || continue; \
      b=$(basename "$f"); cp "$f" "/usr/local/share/ca-certificates/extra-${b%.*}.crt"; n=$((n+1)); \
    done; \
    if [ "$n" -gt 0 ]; then update-ca-certificates; fi; \
    rm -rf /tmp/extra-certs
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY alembic.ini .
COPY migrations ./migrations
COPY graintime ./graintime

RUN useradd --uid 10001 --create-home graintime
USER graintime
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"
CMD ["uvicorn", "graintime.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
