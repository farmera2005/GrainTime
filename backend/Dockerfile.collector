# The collector: the only component that connects to site SQL Server databases.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Trust any extra root certificates placed in ./certs (TLS-inspecting networks;
# see certs/README.md). Does nothing when the folder holds only its README.
COPY --from=certs . /tmp/extra-certs/
RUN set -e; n=0; \
    for f in /tmp/extra-certs/*.crt /tmp/extra-certs/*.pem; do \
      [ -f "$f" ] || continue; \
      b=$(basename "$f"); cp "$f" "/usr/local/share/ca-certificates/extra-${b%.*}.crt"; n=$((n+1)); \
    done; \
    if [ "$n" -gt 0 ]; then update-ca-certificates; fi; \
    rm -rf /tmp/extra-certs
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl gnupg ca-certificates unixodbc \
 && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
      | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
 && echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
      > /etc/apt/sources.list.d/mssql-release.list \
 && apt-get update \
 && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
 && apt-get purge -y curl gnupg && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-collector.txt ./
RUN pip install --no-cache-dir -r requirements-collector.txt
COPY graintime ./graintime

RUN useradd --uid 10001 --create-home graintime
USER graintime
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8081/health', timeout=4).status == 200 else 1)"
CMD ["python", "-m", "graintime.collector.main"]
