# The public, farmer-facing service. Contains only graintime/public: none of the
# api, collector or shared code, so it has no code path to tickets, site
# databases or secrets other than its own read-only database login.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-public.txt .
RUN pip install --no-cache-dir -r requirements-public.txt
COPY graintime/__init__.py ./graintime/__init__.py
COPY graintime/public ./graintime/public

RUN useradd --uid 10002 --create-home graintime-public
USER graintime-public
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4).status == 200 else 1)"
CMD ["uvicorn", "graintime.public.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--no-server-header"]
